<Window x:Class="WindowSharingClient.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Width="300" Height="140"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">
    <Border Background="#1e1e1e" CornerRadius="10"
            BorderBrush="#3a3a3a" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.6" BlurRadius="20" ShadowDepth="0"/>
        </Border.Effect>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
            <TextBlock Text="Remote Desktop Client"
                       Foreground="White" FontSize="15" FontWeight="SemiBold"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="WindowSharingClient"
                       Foreground="#555" FontSize="10"
                       HorizontalAlignment="Center" Margin="0,3,0,0"/>
            <ProgressBar IsIndeterminate="True"
                         Width="220" Height="3"
                         Margin="0,20,0,0"
                         Background="#2a2a2a" Foreground="#0078d4"
                         BorderThickness="0"/>
            <TextBlock Text="載入中…"
                       Foreground="#666" FontSize="10"
                       HorizontalAlignment="Center" Margin="0,10,0,0"/>
        </StackPanel>
    </Border>
</Window>
