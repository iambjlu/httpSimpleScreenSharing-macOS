<Window x:Class="WindowSharingClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remote Desktop Client" Height="620" Width="940"
        Background="#1e1e1e"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <StackPanel x:Name="TopBar" Grid.Row="0" Orientation="Horizontal" Margin="8,6" Background="#2d2d2d">
            <TextBlock Text="Host:" Foreground="White" VerticalAlignment="Center" Margin="4,0,4,0"/>
            <TextBox x:Name="HostBox" Text="192.168.1.x" Width="150" Margin="0,4,8,4"
                     Background="#3c3c3c" Foreground="White" BorderBrush="#555" Padding="4,2"/>
            <TextBlock Text="WS Port:" Foreground="White" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox x:Name="PortBox" Text="8081" Width="60" Margin="0,4,8,4"
                     Background="#3c3c3c" Foreground="White" BorderBrush="#555" Padding="4,2"/>
            <Button x:Name="ConnectBtn" Content="連線" Width="70" Margin="0,4,12,4"
                    Background="#0078d4" Foreground="White" BorderThickness="0"
                    Cursor="Hand" Click="ConnectBtn_Click"/>
            <TextBlock x:Name="StatusText" Text="未連線" Foreground="#888"
                       VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Separator Background="#555" Width="1" Margin="4,4"/>
            <!-- Quality slider -->
            <TextBlock Text="畫質" Foreground="#aaa" VerticalAlignment="Center" Margin="6,0,4,0" FontSize="11"/>
            <Slider x:Name="QualitySlider" Minimum="10" Maximum="100" Value="75" Width="90"
                    VerticalAlignment="Center" Margin="0,0,2,0"
                    ValueChanged="QualitySlider_ValueChanged"/>
            <TextBlock x:Name="QualityLabel" Text="75%" Foreground="White" FontSize="11"
                       VerticalAlignment="Center" Margin="2,0,10,0" Width="32"/>
            <Separator Background="#555" Width="1" Margin="4,4"/>
            <!-- Fullscreen button -->
            <Button x:Name="FullscreenBtn" Content="⛶ 全螢幕" Margin="6,4" Padding="6,2"
                    Background="#444" Foreground="White" BorderThickness="0"
                    Cursor="Hand" Click="FullscreenBtn_Click" FontSize="11"/>
            <Separator Background="#555" Width="1" Margin="4,4"/>
            <!-- Keyboard capture indicator -->
            <Border x:Name="CaptureBadge" Background="#444" CornerRadius="3"
                    Padding="6,2" Margin="4,4" VerticalAlignment="Center">
                <TextBlock x:Name="CaptureLabel" Text="⌨ 未擷取" Foreground="#888" FontSize="11"/>
            </Border>
            <TextBlock Text="(點擊畫面 / Scroll Lock)" Foreground="#555"
                       FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0"/>
        </StackPanel>

        <!-- Stream area with capture-mode border -->
        <Border x:Name="StreamBorder" Grid.Row="1" BorderThickness="3" BorderBrush="Transparent" Background="Black"
                MouseMove="StreamImage_MouseMove"
                MouseDown="StreamImage_MouseDown"
                MouseUp="StreamImage_MouseUp"
                MouseWheel="StreamImage_MouseWheel">
            <Image x:Name="StreamImage"
                   Stretch="Uniform"
                   Focusable="True"
                   Cursor="None"
                   IsHitTestVisible="False"/>
        </Border>

        <!-- Status bar -->
        <StatusBar x:Name="StatusBarRow" Grid.Row="2" Background="#2d2d2d">
            <StatusBarItem>
                <TextBlock x:Name="FpsText" Text="0 fps" Foreground="#aaa" FontSize="11"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="SizeText" Text="" Foreground="#666" FontSize="11"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
