<Window x:Class="WindowSharingClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remote Desktop Client" Height="660" Width="960"
        Background="#1e1e1e"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top bar (two rows) -->
        <Grid x:Name="TopBar" Grid.Row="0" Background="#2d2d2d">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Connection controls -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,5,8,3">
                <TextBlock Text="Host:" Foreground="White" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox x:Name="HostBox" Text="192.168.1.x" Width="150" Margin="0,3,8,3"
                         Background="#3c3c3c" Foreground="White" BorderBrush="#555" Padding="4,2"/>
                <TextBlock Text="Port:" Foreground="White" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox x:Name="PortBox" Text="8081" Width="55" Margin="0,3,8,3"
                         Background="#3c3c3c" Foreground="White" BorderBrush="#555" Padding="4,2"/>
                <Button x:Name="ConnectBtn" Content="連線" Width="70" Margin="0,3,12,3"
                        Background="#0078d4" Foreground="White" BorderThickness="0"
                        Cursor="Hand" Click="ConnectBtn_Click"/>
                <TextBlock x:Name="StatusText" Text="未連線" Foreground="#888"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Separator Background="#555" Width="1" Margin="4,3"/>
                <Button x:Name="FullscreenBtn" Content="⛶ 全螢幕" Margin="6,3" Padding="6,2"
                        Background="#444" Foreground="White" BorderThickness="0"
                        Cursor="Hand" Click="FullscreenBtn_Click" FontSize="11"/>
                <Separator Background="#555" Width="1" Margin="4,3"/>
                <Border x:Name="CaptureBadge" Background="#444" CornerRadius="3"
                        Padding="6,2" Margin="4,3" VerticalAlignment="Center">
                    <TextBlock x:Name="CaptureLabel" Text="⌨ 未擷取" Foreground="#888" FontSize="11"/>
                </Border>
                <TextBlock Text="(點擊畫面 / Scroll Lock)" Foreground="#555"
                           FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0"/>
            </StackPanel>

            <!-- Row 1: Quality / FPS / Resolution settings -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="8,3,8,5">
                <!-- Quality presets -->
                <TextBlock Text="畫質預設" Foreground="#aaa" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="11"/>
                <ComboBox x:Name="QualityPresetCombo" Width="105" FontSize="11" VerticalAlignment="Center"
                          Margin="0,0,6,0" SelectionChanged="QualityPresetCombo_SelectionChanged"
                          Background="#3c3c3c" Foreground="White" BorderBrush="#555">
                    <ComboBoxItem Content="低頻寬 ~1Mbps" Tag="15"/>
                    <ComboBoxItem Content="中畫質 ~3Mbps" Tag="40"/>
                    <ComboBoxItem Content="高畫質 ~8Mbps" Tag="75" IsSelected="True"/>
                    <ComboBoxItem Content="最高畫質" Tag="95"/>
                    <ComboBoxItem x:Name="CustomQualityItem" Content="自訂" Tag="-1"/>
                </ComboBox>

                <!-- Fine-tune slider -->
                <TextBlock Text="微調" Foreground="#888" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="10"/>
                <Slider x:Name="QualitySlider" Minimum="5" Maximum="100" Value="75" Width="80"
                        VerticalAlignment="Center" Margin="0,0,2,0"
                        ValueChanged="QualitySlider_ValueChanged"/>
                <TextBlock x:Name="QualityLabel" Text="75%" Foreground="White" FontSize="11"
                           VerticalAlignment="Center" Margin="2,0,10,0" Width="32"/>

                <Separator Background="#555" Width="1" Margin="4,2"/>

                <!-- FPS selector -->
                <TextBlock Text="FPS" Foreground="#aaa" VerticalAlignment="Center" Margin="6,0,5,0" FontSize="11"/>
                <ComboBox x:Name="FpsCombo" Width="70" FontSize="11" VerticalAlignment="Center"
                          Margin="0,0,10,0" SelectionChanged="FpsCombo_SelectionChanged"
                          Background="#3c3c3c" Foreground="White" BorderBrush="#555">
                    <ComboBoxItem Content="30 fps"/>
                    <ComboBoxItem Content="60 fps" IsSelected="True"/>
                </ComboBox>

                <Separator Background="#555" Width="1" Margin="4,2"/>

                <!-- Server-side 1080p limit -->
                <CheckBox x:Name="Max1080pCheck" Content="伺服器縮至 1080p" Foreground="#aaa"
                          VerticalAlignment="Center" Margin="6,0,0,0" FontSize="11"
                          Checked="Max1080pCheck_Changed" Unchecked="Max1080pCheck_Changed"/>
            </StackPanel>
        </Grid>

        <!-- Stream area -->
        <Border x:Name="StreamBorder" Grid.Row="1" BorderThickness="3" BorderBrush="Transparent" Background="Black"
                MouseMove="StreamImage_MouseMove"
                MouseDown="StreamImage_MouseDown"
                MouseUp="StreamImage_MouseUp"
                MouseWheel="StreamImage_MouseWheel">
            <Grid>
                <Image x:Name="StreamImage"
                       Stretch="Uniform"
                       Focusable="True"
                       Cursor="None"
                       IsHitTestVisible="False"/>

                <!-- Semi-transparent exit-fullscreen button — visible only in fullscreen mode -->
                <Button x:Name="ExitFsBtn"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,16,16" Padding="12,7"
                        Visibility="Collapsed" Cursor="Hand"
                        Click="FullscreenBtn_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background"   Value="#99000000"/>
                            <Setter Property="Foreground"   Value="White"/>
                            <Setter Property="BorderBrush"  Value="#55FFFFFF"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="FontSize"     Value="12"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="5"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#BB0078d4"/>
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#880078d4"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <!-- Compress / exit-fullscreen arrows icon (mirrors the web viewer's SVG) -->
                    <Viewbox Width="18" Height="18">
                        <Canvas Width="24" Height="24">
                            <Path Stroke="White" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M8 3v3a2 2 0 0 1-2 2H3 M21 8h-3a2 2 0 0 1-2-2V3 M3 16h3a2 2 0 0 1 2 2v3 M16 21v-3a2 2 0 0 1 2-2h3"/>
                        </Canvas>
                    </Viewbox>
                </Button>
            </Grid>
        </Border>

        <!-- Status bar -->
        <StatusBar x:Name="StatusBarRow" Grid.Row="2" Background="#2d2d2d">
            <StatusBarItem>
                <TextBlock x:Name="FpsText" Text="0 fps" Foreground="#aaa" FontSize="11"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="BwText" Text="0 kbps" Foreground="#aaa" FontSize="11"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="SizeText" Text="" Foreground="#666" FontSize="11"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
